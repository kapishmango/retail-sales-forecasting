{
  "name": "RetailForecast",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Forecasts",
        "columns": [
          {
            "name": "Store",
            "dataType": "string",
            "sourceColumn": "Store",
            "summarizeBy": "none"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product",
            "summarizeBy": "none"
          },
          {
            "name": "Week",
            "dataType": "dateTime",
            "sourceColumn": "Week",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Actual",
            "dataType": "double",
            "sourceColumn": "Actual",
            "summarizeBy": "sum"
          },
          {
            "name": "Forecast",
            "dataType": "double",
            "sourceColumn": "Forecast",
            "summarizeBy": "sum"
          },
          {
            "name": "Seasonal naive",
            "dataType": "double",
            "sourceColumn": "Seasonal naive",
            "summarizeBy": "sum"
          },
          {
            "name": "Rolling mean",
            "dataType": "double",
            "sourceColumn": "Rolling mean",
            "summarizeBy": "sum"
          },
          {
            "name": "Absolute error",
            "dataType": "double",
            "sourceColumn": "Absolute error",
            "summarizeBy": "sum"
          },
          {
            "name": "Baseline absolute error",
            "dataType": "double",
            "sourceColumn": "Baseline absolute error",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Actual units",
            "expression": "SUM('Forecasts'[Actual])",
            "formatString": "#,0"
          },
          {
            "name": "Forecast units",
            "expression": "SUM('Forecasts'[Forecast])",
            "formatString": "#,0"
          },
          {
            "name": "Seasonal baseline units",
            "expression": "SUM('Forecasts'[Seasonal naive])",
            "formatString": "#,0"
          },
          {
            "name": "Moving average units",
            "expression": "SUM('Forecasts'[Rolling mean])",
            "formatString": "#,0"
          },
          {
            "name": "MAE",
            "expression": "AVERAGE('Forecasts'[Absolute error])",
            "formatString": "#,0.0"
          },
          {
            "name": "WAPE",
            "expression": "DIVIDE(SUM('Forecasts'[Absolute error]), SUMX('Forecasts', ABS('Forecasts'[Actual])))",
            "formatString": "0.0%"
          },
          {
            "name": "Baseline WAPE",
            "expression": "DIVIDE(SUM('Forecasts'[Baseline absolute error]), SUMX('Forecasts', ABS('Forecasts'[Actual])))",
            "formatString": "0.0%"
          },
          {
            "name": "Forecast absolute error",
            "expression": "SUM('Forecasts'[Absolute error])",
            "formatString": "#,0"
          },
          {
            "name": "Seasonal absolute error",
            "expression": "SUM('Forecasts'[Baseline absolute error])",
            "formatString": "#,0"
          }
        ],
